@{
    ViewData["Title"] = "Home Page";
}

<div class="whiteboard-container">
    <canvas id="whiteboard" width="800" height="600" style="border:1px solid #000; cursor:crosshair;"></canvas>
</div>

<script>
    const canvas = document.getElementById('whiteboard');
    const ctx = canvas.getContext('2d');

    let drawing = false;

    // Variables for storing the position of the mouse at the beginning of the stroke
    let posX = 0;
    let posY = 0;

    canvas.addEventListener('mousedown', (e) => {
        updateInitialMousePos(e);
        drawing = true;
    });

    canvas.addEventListener('mouseup', () => {
        drawing = false;
    });

    canvas.addEventListener('mousemove', (e) => {
        draw(e);
    });

    function updateInitialMousePos(e) {
        // offsetX and offsetY are the x and y coords of the mouse relative to the target element, in this case meaning the coords inside the canvas
        posX = e.offsetX;
        posY = e.offsetY;
    }

    function draw(e) {
        if(drawing){
            ctx.lineWidth = 5;
            ctx.lineCap='round';

            ctx.beginPath();

            ctx.moveTo(posX, posY);
            ctx.lineTo(e.offsetX, e.offsetY);
            ctx.stroke();

            ctx.closePath();
            updateInitialMousePos(e)
        }
    }
</script>