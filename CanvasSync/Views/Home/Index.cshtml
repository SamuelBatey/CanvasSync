@{
    ViewData["Title"] = "Home Page";
}
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

<div class="container text-center">
    <div class="row align-items-start">
        <div class="col">
            <a asp-controller="Board" asp-action="Create" class="btn btn-primary">New Board</a>
        </div>
        <div class="col">
            <form asp-controller="Board" asp-action="GetBoard" method="post">
                <label class="form-label" for="ID">Enter Board Code:</label>
                <input class="form-control" type="text" id="ID" name="ID" />
                <input type="submit" value="Enter" class="btn btn-default" />
            </form>
        </div>
    </div>
</div>
