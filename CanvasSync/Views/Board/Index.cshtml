@model IndexViewModel

@{
    ViewData["Title"] = "Home Page";
}
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

<div class="container text-center">
    <div class="row justify-content-center">
        <div class="col-3 newBoardPanel align-content-around">
             <a asp-controller="Board" asp-action="Create" class="btn btn-primary">New Board</a> 
        </div>
        <div class="col-3 existingBoardPanel p-3">
            <form asp-controller="Board" asp-action="FindBoard" method="post">
                <div class="d-flex flex-column justify-content-evenly gap-2 align-items-center">
                    <label class="form-label" for="ID">Enter Board Code:</label>
                    <input class="form-control" type="text" id="ID" name="ID" value="@ViewBag.ID" />
                    <span class="text-danger" asp-validation-for="ID"></span>

                    <button type="submit" value="Enter" class="btn btn-primary">Enter</button>
                </div>
            </form>
        </div>
    </div>
    <div>
        <p class="text-secondary">NOTE: Boards may take up to 60 seconds to load after a period of inactivity because the Azure SQL database uses a serverless tier and may need to wake up.</p>
    </div>
</div>
