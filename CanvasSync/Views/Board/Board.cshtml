@{
    ViewData["Title"] = "Board";
}

<input type="checkbox" id="eraser" />
<label for="eraser">Eraser</label>
<div class="whiteboard-container">
    <canvas id="whiteboard" width="800" height="600" style="border:1px solid #000; cursor:crosshair;"></canvas>
</div>

<script src="~/js/signalr/dist/browser/signalr.js"></script>
<script>
    var connection = new signalR.HubConnectionBuilder().withUrl("/board").build();
    connection.start().catch(function (err){
        return console.error(err.toString());
    })

    const canvas = document.getElementById('whiteboard');
    const ctx = canvas.getContext('2d');
    const eraserBox = document.getElementById('eraser');

    let drawing = false;

    // Variables for storing the position of the mouse at the beginning of the stroke
    let posX = 0;
    let posY = 0;

    canvas.addEventListener('mousedown', (e) => {
        updateInitialMousePos(e);
        drawing = true;
    });

    canvas.addEventListener('mouseup', () => {
        drawing = false;
    });

    canvas.addEventListener('mousemove', (e) => {
        draw(e);
    });

    function updateInitialMousePos(e) {
        // offsetX and offsetY are the x and y coords of the mouse relative to the target element, in this case meaning the coords inside the canvas
        posX = e.offsetX;
        posY = e.offsetY;
    }

    function draw(e) {
        if (drawing) {
            drawLine(posX, posY, e.offsetX, e.offsetY, 5, eraserBox.checked);
            connection.invoke("SendBoard", posX, posY, e.offsetX, e.offsetY, 5, eraserBox.checked).catch(function (err) {
                return console.error(err.toString());
            });
            updateInitialMousePos(e);

        }
    }

    function drawLine(startX, startY, endX, endY, thickness, eraser) {
        if (eraser === true) {
            ctx.globalCompositeOperation = 'destination-out';
            ctx.lineWidth = 20;
        } else {
            ctx.globalCompositeOperation = 'source-over';
            ctx.lineWidth = 5;
        }
        ctx.lineCap = 'round';
        ctx.beginPath();
        ctx.moveTo(startX, startY);
        ctx.lineTo(endX, endY);
        ctx.stroke();
        ctx.closePath();
    }

    connection.on("ReceiveBoard", function (startX, startY, endX, endY, thickness, eraser) {
        drawLine(startX, startY, endX, endY, thickness, eraser);
    });
</script>